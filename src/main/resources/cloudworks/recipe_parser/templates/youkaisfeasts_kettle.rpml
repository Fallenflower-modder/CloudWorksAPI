{
  "type": "youkaisfeasts:kettle",
  <script,set_global_fluid_transfer=true,set_global_default_transfer_rate=250>
  "input": [
    <object,id=ingStruct>
      "item": <input,id=ingItem,count=1,unit=item,type=solid>
      "tag": <input,id=ingTag,count=1,unit=item,type=tag>
    </object>
    <duplicate,id=dupIng,structure=ingStruct>
  ],
  "result": {
    "amount": <amount,output_id=res>
    "id": <output,id=res,count=1,unit=fluid,type=fluid>
  }
}